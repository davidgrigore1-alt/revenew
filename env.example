NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional server-only synthesis provider. Use "ollama", "openai", or "none".
REVENEW_AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

RESEND_API_KEY=

# Google Workspace connector (server-only OAuth authorization-code flow).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Picker Cloud Project Number and a browser key restricted to Google Picker API
# and the exact ReveNew HTTPS referrers. These two values are public, not credentials.
# Public Picker/GIS configuration is loaded in the authorized Drive surface.
# GIS requests the ephemeral drive.file token only on an explicit selection click.
GOOGLE_PICKER_APP_ID=
GOOGLE_PICKER_BROWSER_KEY=

# 32 random bytes encoded as base64. Never expose this as NEXT_PUBLIC_*.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Access mode: "preview" lets authenticated internal testers choose an allowlisted
# preview plan without payment. "paid" enforces server-verified subscriptions.
# Missing or invalid values fail safe to "paid" in production and "preview" locally.
REVENEW_ACCESS_MODE=preview

# Usage metering mode: off, observe, enforce.
# Use observe until the additive usage migration is applied and verified.
REVENEW_USAGE_MODE=observe

# Public canonical site URL used for sitemap and metadata. No secret value.
REVENEW_PUBLIC_SITE_URL=https://revenew.ro
OLLAMA_TIMEOUT_MS=45000
