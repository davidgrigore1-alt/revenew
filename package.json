{
  "name": "revenew",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "demo:dev": "node scripts/demo/dev-local-demo.mjs",
    "demo:seed": "node scripts/demo/seed-local-demo.mjs",
    "demo:verify": "node scripts/demo/verify-local-demo.mjs",
    "demo:buyer-ready": "npm run demo:seed && npm run demo:verify",
    "demo:reset": "node scripts/demo/reset-local-demo.mjs",
    "billing:access": "node scripts/billing/manual-paid-access.mjs",
    "billing:verify-local": "node scripts/billing/verify-manual-paid-access-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "node --test tests/*.test.mjs",
    "test:targeted": "node --test tests/auth-account-flow.test.mjs tests/auth-session-recovery.test.mjs tests/authorization-surface.test.mjs tests/business-members-rls.test.mjs tests/commercial-ingestion.test.mjs tests/navigation-serialization.test.mjs tests/recoverable-revenue-engine.test.mjs",
    "test:sending": "node --test tests/ai-follow-up-studio.test.mjs tests/human-approved-email-sending.test.mjs",
    "test:response-loop": "node --test tests/commercial-response-outcome-loop.test.mjs",
    "test:enterprise": "node --test tests/enterprise-workspace-governance.test.mjs",
    "validate:migrations": "node scripts/validation/check-migrations.mjs",
    "validate:security": "node scripts/validation/check-repository-safety.mjs",
    "validate:diff": "git diff --check",
    "validate:quick": "npm run typecheck && npm run lint && npm run test:targeted && npm run validate:migrations && npm run validate:security && npm run validate:diff",
    "validate": "npm run typecheck && npm run lint && npm test && npm run validate:migrations && npm run validate:security && npm run build && npm run validate:diff"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.7",
    "next": "15.5.24",
    "openai": "^6.42.0",
    "papaparse": "^5.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "^20.16.10",
    "@types/papaparse": "^5.3.16",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
