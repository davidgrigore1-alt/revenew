"use client";

import type { ReactNode } from "react";
import {
  ArrowPathIcon,
  CheckCircleIcon,
  ExclamationTriangleIcon,
  XCircleIcon
} from "@heroicons/react/20/solid";
import {
  ArrowTopRightOnSquareIcon,
  ClockIcon,
  KeyIcon,
  ShieldCheckIcon
} from "@heroicons/react/24/outline";
import { useState, useTransition } from "react";
import { useRouter } from "next/navigation";
import { IntegrationBrandIcon } from "@/components/ui/IntegrationBrandIcon";
import { StatusPill } from "@/components/ui/StatusPill";
import type { GoogleWorkspacePublicState } from "@/lib/google-workspace/types";
import { formatProductDateTime } from "@/lib/ui/presentation";

type Props = { state: GoogleWorkspacePublicState; notice?: string | null };

const labels = {
  not_connected: "Neconectat",
  connected: "Conectat",
  syncing: "Sincronizare",
  action_required: "Acțiune necesară",
  error: "Necesită atenție",
  disconnected: "Neconectat"
} as const;

function ProviderMark() {
  return (
    <div className="grid h-11 w-11 place-items-center rounded-[10px] border border-[rgb(var(--border))] bg-white shadow-sm" aria-hidden="true">
      <svg viewBox="0 0 24 24" className="h-6 w-6">
        <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.2 3-7.2Z"/>
        <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3.1v2.6A10 10 0 0 0 12 22Z"/>
        <path fill="#FBBC05" d="M6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9l3.3-2.6Z"/>
        <path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.8A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.9 5.5l3.3 2.6A5.9 5.9 0 0 1 12 5.9Z"/>
      </svg>
    </div>
  );
}

function GmailMark() {
  return <IntegrationBrandIcon provider="gmail" />;
}

function CalendarMark() {
  return <IntegrationBrandIcon provider="google_calendar" />;
}

function StatusIcon({ status }: { status: keyof typeof labels }) {
  if (status === "connected") return <CheckCircleIcon className="h-3.5 w-3.5" aria-hidden="true" />;
  if (status === "syncing") return <ArrowPathIcon className="h-3.5 w-3.5 animate-spin motion-reduce:animate-none" aria-hidden="true" />;
  if (status === "action_required") return <ExclamationTriangleIcon className="h-3.5 w-3.5" aria-hidden="true" />;
  if (status === "error") return <XCircleIcon className="h-3.5 w-3.5" aria-hidden="true" />;
  return <span className="h-2 w-2 rounded-full border border-current" aria-hidden="true" />;
}

function statusTone(status: keyof typeof labels) {
  if (status === "connected") return "success" as const;
  if (status === "syncing") return "gold" as const;
  if (status === "action_required" || status === "error") return "warning" as const;
  return "neutral" as const;
}

function CapabilityRow({
  icon,
  name,
  description,
  status,
  count,
  statusLabel
}: {
  icon: ReactNode;
  name: string;
  description: string;
  status: keyof typeof labels;
  count?: string;
  statusLabel?: string;
}) {
  return (
    <div className="grid gap-3 border-t border-[rgb(var(--border))] py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
      <div className="flex items-center gap-3">
        {icon}
        <div>
          <p className="text-sm font-semibold text-[rgb(var(--foreground))]">{name}</p>
          <p className="mt-1 text-xs leading-5 text-[rgb(var(--text-muted))]">{description}</p>
        </div>
      </div>
      <div className="flex flex-wrap items-center gap-3 sm:justify-end">
        {count ? <span className="text-xs tabular-nums text-[rgb(var(--text-faint))]">{count}</span> : null}
        <StatusPill tone={statusTone(status)} size="small">
          <StatusIcon status={status} />
          {statusLabel ?? labels[status]}
        </StatusPill>
      </div>
    </div>
  );
}

const primaryActionClass =
  "focus-ring inline-flex min-h-9 items-center justify-center rounded-button bg-[rgb(var(--primary))] px-3.5 text-xs font-semibold text-[rgb(var(--primary-foreground))] transition-[background-color,transform] duration-fast hover:-translate-y-px hover:bg-[rgb(var(--primary-hover))] active:translate-y-0 active:scale-[0.985] motion-reduce:transform-none";

const secondaryActionClass =
  "focus-ring inline-flex min-h-9 items-center justify-center rounded-button border border-[rgb(var(--border))] bg-[rgb(var(--surface))] px-3.5 text-xs font-semibold text-[rgb(var(--foreground))] transition-colors hover:border-[rgb(var(--border-strong))] hover:bg-[rgb(var(--surface-subtle))]";

export function GoogleWorkspaceCard({ state, notice }: Props) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [details, setDetails] = useState(false);
  const [message, setMessage] = useState<string | null>(
    notice === "send-enabled"
      ? "Permisiunea de trimitere Gmail este activă. Fiecare mesaj necesită confirmare finală."
      : notice === "connected"
        ? "Conexiunea securizată este pregătită. Pornește prima sincronizare."
        : notice === "invalid-state"
          ? "Conexiunea a fost oprită deoarece verificarea de securitate a expirat."
          : notice && notice !== "consent-denied"
            ? "Conexiunea Google nu a putut fi finalizată."
            : null
  );
  const connection = state.connection;

  function mutate(path: string, success: string) {
    setMessage(null);
    startTransition(async () => {
      const response = await fetch(path, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: "{}"
      });
      const body = await response.json().catch(() => ({})) as { error?: string };
      setMessage(response.ok ? success : body.error ?? "Operațiunea nu a putut fi finalizată.");
      router.refresh();
    });
  }

  if (!state.configured) {
    return (
      <section className="product-work-surface overflow-hidden">
        <div className="flex items-start gap-4 p-5 sm:p-6">
          <ProviderMark />
          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-2">
              <p className="micro-label">Google Workspace</p>
              <StatusPill tone="warning" size="small">Configurare necesară</StatusPill>
            </div>
            <h3 className="mt-2 text-lg font-semibold text-[rgb(var(--foreground))]">OAuth și criptarea trebuie configurate pe server.</h3>
            <p className="mt-2 max-w-2xl text-sm leading-6 text-[rgb(var(--text-muted))]">După configurare, utilizatorii pot autoriza Gmail și Google Calendar fără ca tokenurile să ajungă în browser.</p>
          </div>
        </div>
      </section>
    );
  }

  if (!connection) {
    return (
      <section className="product-work-surface overflow-hidden">
        <div className="grid gap-6 p-5 sm:p-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
          <div className="flex items-start gap-4">
            <ProviderMark />
            <div className="min-w-0">
              <div className="flex flex-wrap items-center gap-2">
                <p className="micro-label">Google Workspace</p>
                <StatusPill tone="neutral" size="small">Neconectat</StatusPill>
              </div>
              <h3 className="mt-2 text-xl font-semibold tracking-[-0.015em] text-[rgb(var(--foreground))]">Gmail + Google Calendar</h3>
              <p className="mt-2 max-w-2xl text-sm leading-6 text-[rgb(var(--text-muted))]">Adaugă conversații și întâlniri autorizate în contextul comercial personal. Citirea și trimiterea Gmail rămân capabilități separate.</p>
            </div>
          </div>
          <a href="/api/integrations/google/connect" className={primaryActionClass}>Conectează Google Workspace</a>
        </div>

        <div className="grid border-t border-[rgb(var(--border))] sm:grid-cols-2 sm:divide-x sm:divide-[rgb(var(--border))]">
          <div className="flex gap-3 p-4 sm:p-5"><GmailMark /><div><p className="text-sm font-semibold text-[rgb(var(--foreground))]">Gmail</p><p className="mt-1 text-xs leading-5 text-[rgb(var(--text-muted))]">Fire, participanți, subiect și interacțiune recentă.</p></div></div>
          <div className="flex gap-3 border-t border-[rgb(var(--border))] p-4 sm:border-t-0 sm:p-5"><CalendarMark /><div><p className="text-sm font-semibold text-[rgb(var(--foreground))]">Google Calendar</p><p className="mt-1 text-xs leading-5 text-[rgb(var(--text-muted))]">Întâlniri, participanți și context comercial apropiat.</p></div></div>
        </div>
      </section>
    );
  }

  const gmailCount = connection.counts.emails ? `${connection.counts.emails} emailuri` : undefined;
  const eventCount = connection.counts.calendarEvents ? `${connection.counts.calendarEvents} întâlniri` : undefined;
  const requiresReconnect =
    connection.status === "action_required" ||
    (connection.gmailStatus === "action_required" && connection.calendarStatus === "action_required");
  const allHealthy = connection.gmailStatus === "connected" && connection.calendarStatus === "connected";
  const overallLabel = connection.syncing
    ? "Sincronizare în curs"
    : allHealthy
      ? "Context sincronizat"
      : requiresReconnect
        ? "Reconectare necesară"
        : "Verifică sursele";

  return (
    <section className="product-work-surface overflow-hidden">
      <div className="grid gap-5 p-5 sm:p-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
        <div className="flex min-w-0 items-start gap-4">
          <ProviderMark />
          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-2">
              <p className="micro-label">Google Workspace</p>
              <StatusPill tone={allHealthy ? "success" : requiresReconnect ? "warning" : "gold"} size="small">{overallLabel}</StatusPill>
            </div>
            <h3 className="mt-2 truncate text-xl font-semibold tracking-[-0.015em] text-[rgb(var(--foreground))]">{connection.email}</h3>
            <p className="mt-1 text-xs text-[rgb(var(--text-faint))]">Autorizat {formatProductDateTime(connection.connectedAt)}</p>
          </div>
        </div>

        <div className="flex flex-wrap gap-2">
          {requiresReconnect ? (
            <a href="/api/integrations/google/connect" className={primaryActionClass}>Reconectează</a>
          ) : (
            <button
              type="button"
              disabled={pending || connection.syncing}
              onClick={() => mutate("/api/integrations/google/sync", "Sincronizarea s-a încheiat. Starea surselor a fost actualizată.")}
              className={`${primaryActionClass} disabled:cursor-wait disabled:opacity-60`}
            >
              {pending || connection.syncing ? "Sincronizare…" : "Sincronizează"}
            </button>
          )}
          {!connection.capabilities.emailSend ? (
            <a href="/api/integrations/google/connect?capability=email_send" className={secondaryActionClass}>Activează trimiterea</a>
          ) : null}
          <button type="button" onClick={() => setDetails((value) => !value)} className={secondaryActionClass}>
            {details ? "Închide" : "Gestionează"}
          </button>
        </div>
      </div>

      {requiresReconnect ? (
        <div role="alert" className="mx-5 mb-1 rounded-control border border-[rgb(var(--warning-border))] bg-[rgb(var(--warning-background))] px-3 py-2 text-xs leading-5 text-[rgb(var(--warning-text))] sm:mx-6">
          Google a revocat sau a invalidat accesul. Reconectează contul pentru a relua sincronizarea.
        </div>
      ) : null}

      {message ? (
        <div role="status" className="mx-5 mb-1 rounded-control border border-[rgb(var(--primary-border))] bg-[rgb(var(--primary-soft))] px-3 py-2 text-xs leading-5 text-[rgb(var(--text-secondary))] sm:mx-6">
          {message}
        </div>
      ) : null}

      <div className="border-t border-[rgb(var(--border))] px-5 sm:px-6">
        <CapabilityRow
          icon={<GmailMark />}
          name="Gmail · citire"
          description="Conversații și fire autorizate pentru context comercial."
          status={connection.gmailStatus}
          count={gmailCount}
        />
        <CapabilityRow
          icon={<GmailMark />}
          name="Gmail · trimitere"
          description={connection.capabilities.emailSend
            ? "Disponibilă numai după revizuire și confirmare finală."
            : "Necesită o permisiune separată. Confirmarea rămâne obligatorie pentru fiecare mesaj."}
          status={connection.capabilities.emailSend ? "connected" : "action_required"}
          statusLabel={connection.capabilities.emailSend ? "Conectat" : "Permisiune separată"}
        />
        <CapabilityRow
          icon={<CalendarMark />}
          name="Google Calendar"
          description="Întâlniri și participanți autorizați. ReveNew nu modifică evenimente."
          status={connection.calendarStatus}
          count={eventCount}
        />
      </div>

      <div className="grid border-t border-[rgb(var(--border))] sm:grid-cols-3 sm:divide-x sm:divide-[rgb(var(--border))]">
        <div className="p-4 sm:p-5">
          <p className="flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-[rgb(var(--text-faint))]"><ClockIcon className="h-3.5 w-3.5" aria-hidden="true" />Ultima sincronizare</p>
          <p className="mt-2 text-xs font-medium text-[rgb(var(--text-secondary))]">{connection.lastSuccessfulSyncAt ? formatProductDateTime(connection.lastSuccessfulSyncAt) : "Nicio sincronizare"}</p>
        </div>
        <div className="border-t border-[rgb(var(--border))] p-4 sm:border-t-0 sm:p-5">
          <p className="flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-[rgb(var(--text-faint))]"><ShieldCheckIcon className="h-3.5 w-3.5" aria-hidden="true" />Sănătate context</p>
          <p className="mt-2 text-xs font-medium text-[rgb(var(--text-secondary))]">{allHealthy ? "Ambele surse sunt disponibile" : "Verifică starea fiecărei surse"}</p>
        </div>
        <div className="border-t border-[rgb(var(--border))] p-4 sm:border-t-0 sm:p-5">
          <p className="flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-[rgb(var(--text-faint))]"><KeyIcon className="h-3.5 w-3.5" aria-hidden="true" />Control extern</p>
          <p className="mt-2 text-xs font-medium text-[rgb(var(--text-secondary))]">{connection.capabilities.emailSend ? "Send permis, confirmare obligatorie" : "Citire și context; fără send"}</p>
        </div>
      </div>

      {details ? (
        <div className="grid gap-5 border-t border-[rgb(var(--border))] bg-[rgb(var(--surface-subtle))] p-5 sm:p-6">
          <div>
            <p className="micro-label">Permisiuni active</p>
            <div className="mt-3 grid gap-2 text-sm leading-6 text-[rgb(var(--text-muted))]">
              <p><strong className="font-semibold text-[rgb(var(--foreground))]">Gmail:</strong> poate furniza emailurile autorizate pentru context comercial.</p>
              <p><strong className="font-semibold text-[rgb(var(--foreground))]">Calendar:</strong> poate furniza întâlnirile și participanții autorizați.</p>
              <p><strong className="font-semibold text-[rgb(var(--foreground))]">Execuție:</strong> {connection.capabilities.emailSend ? "Gmail send este permis numai după confirmarea finală; Calendar rămâne read-only." : "nu există permisiune Gmail send; Calendar rămâne read-only."}</p>
            </div>
          </div>

          {connection.latestRun ? (
            <div>
              <p className="micro-label">Ultima activitate</p>
              <div className="mt-3 grid gap-3 rounded-control border border-[rgb(var(--border))] bg-[rgb(var(--surface))] p-3 text-xs sm:grid-cols-[minmax(0,1fr)_auto]">
                <div>
                  <p className="font-semibold text-[rgb(var(--foreground))]">{connection.latestRun.source === "gmail" ? "Gmail" : connection.latestRun.source === "calendar" ? "Calendar" : "Google Workspace"}</p>
                  <p className="mt-1 text-[rgb(var(--text-faint))]">{formatProductDateTime(connection.latestRun.startedAt)}</p>
                </div>
                <div className="text-left text-[rgb(var(--text-secondary))] sm:text-right">
                  <p>{connection.latestRun.processedCount} elemente procesate</p>
                  <p className="mt-1 text-[rgb(var(--text-faint))]">{labels[connection.latestRun.status === "failed" ? "error" : connection.latestRun.status === "running" ? "syncing" : "connected"]}</p>
                </div>
              </div>
            </div>
          ) : null}

          <details className="text-xs text-[rgb(var(--text-muted))]">
            <summary className="focus-ring inline-flex cursor-pointer list-none items-center gap-1.5 rounded-button font-semibold text-[rgb(var(--text-secondary))] marker:hidden">
              Detalii tehnice
              <ArrowTopRightOnSquareIcon className="h-3.5 w-3.5" aria-hidden="true" />
            </summary>
            <p className="mt-2 max-w-3xl leading-5">Identitatea Google, Gmail read și Calendar read-only sunt separate de permisiunea Gmail send. Credentialele sunt păstrate server-side, iar tokenurile nu sunt expuse în browser.</p>
          </details>

          <div className="flex flex-col gap-4 border-t border-[rgb(var(--border))] pt-4 sm:flex-row sm:items-center sm:justify-between">
            <p className="max-w-2xl text-xs leading-5 text-[rgb(var(--text-faint))]">Deconectarea revocă accesul când Google răspunde, invalidează credentialul local și șterge contextul Gmail și Calendar sincronizat pentru acest cont.</p>
            <button
              type="button"
              disabled={pending}
              onClick={() => mutate("/api/integrations/google/disconnect", "Contul Google a fost deconectat, iar contextul sincronizat a fost eliminat.")}
              className="focus-ring min-h-9 shrink-0 rounded-button border border-[rgb(var(--danger-border))] px-3 text-xs font-semibold text-[rgb(var(--danger-text))] hover:bg-[rgb(var(--danger-background))] disabled:opacity-60"
            >
              Deconectează
            </button>
          </div>
        </div>
      ) : null}
    </section>
  );
}
