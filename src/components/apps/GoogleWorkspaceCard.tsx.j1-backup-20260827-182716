"use client";

import { IntegrationBrandIcon } from "@/components/ui/IntegrationBrandIcon";

import type { ReactNode } from "react";
import { ArrowPathIcon, CheckCircleIcon, ExclamationTriangleIcon, XCircleIcon } from "@heroicons/react/20/solid";

import { useState, useTransition } from "react";
import { useRouter } from "next/navigation";
import type { GoogleWorkspacePublicState } from "@/lib/google-workspace/types";
import { formatProductDateTime } from "@/lib/ui/presentation";

type Props = { state: GoogleWorkspacePublicState; notice?: string | null };

const labels = {
  not_connected: "Neconectat",
  connected: "Conectat",
  syncing: "Sincronizare",
  action_required: "Acțiune necesară",
  error: "Necesită atenție",
  disconnected: "Neconectat"
} as const;

function ProviderMark() {
  return (
    <div className="grid h-10 w-10 place-items-center rounded-[10px] border border-white/10 bg-white" aria-hidden="true">
      <svg viewBox="0 0 24 24" className="h-6 w-6"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.2 3-7.2Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9l3.3-2.6Z"/><path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.8A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.9 5.5l3.3 2.6A5.9 5.9 0 0 1 12 5.9Z"/></svg>
    </div>
  );
}

function GmailMark() {
  return <IntegrationBrandIcon provider="gmail" />;
}

function CalendarMark() {
  return <IntegrationBrandIcon provider="google_calendar" />;
}

function StatusIcon({ status }: { status: keyof typeof labels }) {
  if (status === "connected") return <CheckCircleIcon className="mr-1.5 h-3.5 w-3.5" aria-hidden="true" />;
  if (status === "syncing") return <ArrowPathIcon className="mr-1.5 h-3.5 w-3.5 animate-spin motion-reduce:animate-none" aria-hidden="true" />;
  if (status === "action_required") return <ExclamationTriangleIcon className="mr-1.5 h-3.5 w-3.5" aria-hidden="true" />;
  if (status === "error") return <XCircleIcon className="mr-1.5 h-3.5 w-3.5" aria-hidden="true" />;
  return <span className="mr-1.5 h-2 w-2 rounded-full border border-current" aria-hidden="true" />;
}

function CapabilityRow({ icon, name, description, status, count, statusLabel }: { icon: ReactNode; name: string; description: string; status: keyof typeof labels; count?: string; statusLabel?: string }) {
  return (
    <div className="grid gap-3 border-t border-white/[0.08] py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
      <div className="flex items-center gap-3">{icon}<div><p className="text-sm font-semibold text-white">{name}</p><p className="mt-1 text-xs leading-5 text-neutral-400">{description}</p></div></div>
      <div className="flex items-center gap-3 sm:justify-end">
        {count ? <span className="text-xs tabular-nums text-neutral-500">{count}</span> : null}
        <span className={`inline-flex min-h-6 items-center rounded-full border px-2.5 text-[0.6875rem] font-semibold uppercase tracking-[0.08em] ${status === "connected" ? "border-emerald-700/60 bg-emerald-950/50 text-emerald-300" : status === "syncing" ? "border-[#d6b56d]/50 bg-[#d6b56d]/10 text-[#e7c982]" : status === "action_required" || status === "error" ? "border-amber-700/60 bg-amber-950/40 text-amber-300" : "border-white/10 bg-white/[0.03] text-neutral-400"}`}>
          <StatusIcon status={status} />
          {statusLabel ?? labels[status]}
        </span>
      </div>
    </div>
  );
}

export function GoogleWorkspaceCard({ state, notice }: Props) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [details, setDetails] = useState(false);
  const [message, setMessage] = useState<string | null>(
    notice === "send-enabled" ? "Permisiunea de trimitere Gmail este activă. Fiecare mesaj necesită confirmare finală."
      : notice === "connected" ? "Conexiunea securizată este pregătită. Pornește prima sincronizare."
      : notice === "invalid-state" ? "Conexiunea a fost oprită deoarece verificarea de securitate a expirat."
        : notice && notice !== "consent-denied" ? "Conexiunea Google nu a putut fi finalizată." : null
  );
  const connection = state.connection;

  function mutate(path: string, success: string) {
    setMessage(null);
    startTransition(async () => {
      const response = await fetch(path, { method: "POST", headers: { "content-type": "application/json" }, body: "{}" });
      const body = await response.json().catch(() => ({})) as { error?: string };
      setMessage(response.ok ? success : body.error ?? "Operațiunea nu a putut fi finalizată.");
      router.refresh();
    });
  }

  if (!state.configured) {
    return (
      <section className="rounded-[14px] border border-white/10 bg-[#111] p-5 sm:p-6">
        <div className="flex items-start gap-4"><ProviderMark /><div><p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#d6b56d]">Google Workspace</p><h2 className="mt-1 text-lg font-semibold text-white">Configurare de server necesară</h2></div></div>
        <p className="mt-5 max-w-2xl text-sm leading-6 text-neutral-400">Administratorul trebuie să configureze clientul OAuth Google și cheia de criptare înainte ca un cont să poată fi autorizat.</p>
      </section>
    );
  }

  if (!connection) {
    return (
      <section className="group rounded-[14px] border border-white/10 bg-[#111] p-5 transition-[background-color,border-color,transform] duration-normal ease-standard hover:-translate-y-px hover:border-[#d6b56d]/35 motion-reduce:transform-none sm:p-6">
        <div className="flex flex-col justify-between gap-6 sm:flex-row sm:items-start">
          <div className="flex items-start gap-4"><ProviderMark /><div><p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#d6b56d]">Google Workspace</p><h2 className="mt-1 text-xl font-semibold text-white">Gmail + Google Calendar</h2><p className="mt-2 max-w-xl text-sm leading-6 text-neutral-400">Folosește conversațiile și întâlnirile autorizate pentru context comercial personal, fără permisiuni de trimitere sau modificare.</p></div></div>
          <a href="/api/integrations/google/connect" className="focus-ring inline-flex h-9 shrink-0 items-center justify-center rounded-[8px] bg-[#d6b56d] px-4 text-sm font-semibold text-black transition-[background-color,transform] duration-fast ease-standard hover:-translate-y-px hover:bg-[#e0c27e] active:translate-y-0 active:scale-[0.985] motion-reduce:transform-none">Conectează Google Workspace</a>
        </div>
        <div className="mt-6 grid gap-3 border-t border-white/[0.08] pt-5 sm:grid-cols-2">
          <div><p className="text-sm font-semibold text-white">Gmail</p><p className="mt-1 text-xs leading-5 text-neutral-500">Conversații, participanți, fir și interacțiune recentă.</p></div>
          <div><p className="text-sm font-semibold text-white">Google Calendar</p><p className="mt-1 text-xs leading-5 text-neutral-500">Întâlniri, participanți și context comercial apropiat.</p></div>
        </div>
        <details className="mt-4 text-xs text-neutral-400"><summary className="focus-ring cursor-pointer rounded font-semibold text-[#d6b56d]">Ce date poate folosi ReveNew?</summary><p className="mt-2 max-w-2xl leading-5">ReveNew păstrează numai câmpurile necesare contextului comercial. Atașamentele, resursele remote și payload-urile brute nu sunt importate.</p></details>
      </section>
    );
  }

  const gmailCount = connection.counts.emails ? `${connection.counts.emails} emailuri procesate` : undefined;
  const eventCount = connection.counts.calendarEvents ? `${connection.counts.calendarEvents} întâlniri disponibile` : undefined;
  const requiresReconnect = connection.status === "action_required" || (connection.gmailStatus === "action_required" && connection.calendarStatus === "action_required");
  const allHealthy = connection.gmailStatus === "connected" && connection.calendarStatus === "connected";
  const overallLabel = connection.syncing ? "Sincronizare în curs" : allHealthy ? "Context sincronizat" : requiresReconnect ? "Reconectare necesară" : "Verifică sursele";
  const OverallIcon = connection.syncing ? ArrowPathIcon : allHealthy ? CheckCircleIcon : ExclamationTriangleIcon;
  return (
    <section className="rounded-[14px] border border-white/10 bg-[#111] p-5 sm:p-6">
      <div className="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
        <div className="flex items-start gap-4"><ProviderMark /><div><div className="flex flex-wrap items-center gap-2"><p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#d6b56d]">Google Workspace</p><span className={`inline-flex items-center rounded-full border px-2 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.08em] ${allHealthy ? "border-emerald-700/60 bg-emerald-950/50 text-emerald-300" : "border-amber-700/60 bg-amber-950/40 text-amber-300"}`}><OverallIcon className={`mr-1 h-3 w-3 ${connection.syncing ? "animate-spin motion-reduce:animate-none" : ""}`} aria-hidden="true"/>{overallLabel}</span></div><h2 className="mt-1.5 text-xl font-semibold text-white">{connection.email}</h2><p className="mt-1 text-xs text-neutral-500">Autorizat {formatProductDateTime(connection.connectedAt)}</p></div></div>
        <div className="flex flex-wrap gap-2">
          {requiresReconnect ? (
            <a href="/api/integrations/google/connect" className="focus-ring inline-flex min-h-9 items-center rounded-[8px] bg-[#d6b56d] px-3.5 text-xs font-semibold text-black hover:bg-[#e0c27e]">Reconectează</a>
          ) : (
            <button type="button" disabled={pending || connection.syncing} onClick={() => mutate("/api/integrations/google/sync", "Sincronizarea s-a încheiat. Starea surselor a fost actualizată.")} className="focus-ring min-h-9 rounded-[8px] bg-[#d6b56d] px-3.5 text-xs font-semibold text-black disabled:cursor-wait disabled:opacity-60">{pending || connection.syncing ? "Sincronizare…" : "Sincronizează acum"}</button>
          )}
          {!connection.capabilities.emailSend ? <a href="/api/integrations/google/connect?capability=email_send" className="focus-ring inline-flex min-h-9 items-center rounded-[8px] border border-white/10 px-3.5 text-xs font-semibold text-white hover:border-[#d6b56d]/40">Activează trimiterea</a> : null}
          <button type="button" onClick={() => setDetails((value) => !value)} className="focus-ring min-h-9 rounded-[8px] border border-white/10 px-3.5 text-xs font-semibold text-white hover:border-white/20">{details ? "Închide detaliile" : "Gestionează"}</button>
        </div>
      </div>
      {requiresReconnect ? <p role="alert" className="mt-4 rounded-[8px] border border-amber-800/60 bg-amber-950/30 px-3 py-2 text-xs leading-5 text-amber-200">Google a revocat sau a invalidat accesul. Reconectează contul pentru a relua sincronizarea.</p> : null}
      {message ? <p role="status" className="mt-4 rounded-[8px] border border-[#d6b56d]/25 bg-[#d6b56d]/[0.07] px-3 py-2 text-xs leading-5 text-[#e7c982]">{message}</p> : null}
      <div className="mt-5">
        <CapabilityRow icon={<GmailMark />} name="Gmail · citire" description="Conversații și fire autorizate pentru context comercial." status={connection.gmailStatus} count={gmailCount} />
        <CapabilityRow icon={<GmailMark />} name="Gmail · trimitere" description={connection.capabilities.emailSend ? "Disponibilă numai după revizuire și confirmare finală." : "Necesită o permisiune Google separată. Confirmarea rămâne obligatorie pentru fiecare mesaj."} status={connection.capabilities.emailSend ? "connected" : "action_required"} statusLabel={connection.capabilities.emailSend ? "Conectat" : "Permisiune necesară"} />
        <CapabilityRow icon={<CalendarMark />} name="Google Calendar" description="Întâlniri și participanți autorizați. ReveNew nu modifică evenimente." status={connection.calendarStatus} count={eventCount} />
      </div>
      <div className="grid gap-3 border-t border-white/[0.08] pt-4 text-xs sm:grid-cols-2">
        <div><p className="uppercase tracking-[0.1em] text-neutral-600">Ultima sincronizare</p><p className="mt-1.5 font-medium text-neutral-300">{connection.lastSuccessfulSyncAt ? formatProductDateTime(connection.lastSuccessfulSyncAt) : "Nicio sincronizare"}</p></div>
        <div><p className="uppercase tracking-[0.1em] text-neutral-600">Sănătate context</p><p className="mt-1.5 font-medium text-neutral-300">{connection.gmailStatus === "connected" && connection.calendarStatus === "connected" ? "Ambele surse sunt disponibile" : "Verifică starea fiecărei surse"}</p></div>
      </div>
      {details ? (
        <div className="mt-6 grid gap-6 border-t border-white/[0.08] pt-6">
          <div><p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#d6b56d]">Permisiuni</p><div className="mt-3 grid gap-2 text-sm leading-6 text-neutral-400"><p><strong className="font-semibold text-neutral-200">Gmail:</strong> ReveNew poate citi emailurile autorizate pentru a construi context comercial.</p><p><strong className="font-semibold text-neutral-200">Calendar:</strong> ReveNew poate citi evenimentele autorizate pentru a identifica întâlniri și participanți.</p><p className="font-semibold text-white">{connection.capabilities.emailSend ? "Gmail poate trimite doar după confirmare finală; Calendar rămâne doar-citire." : "Trimiterea Gmail nu este autorizată; Calendar rămâne doar-citire."}</p></div></div>
          {connection.latestRun ? <div><p className="text-xs font-semibold uppercase tracking-[0.14em] text-[#d6b56d]">Ultima activitate reală</p><div className="mt-3 flex items-start justify-between gap-4 rounded-[8px] border border-white/[0.08] bg-black/30 p-3 text-xs"><div><p className="font-semibold text-white">{connection.latestRun.source === "gmail" ? "Gmail" : connection.latestRun.source === "calendar" ? "Calendar" : "Google Workspace"}</p><p className="mt-1 text-neutral-500">{formatProductDateTime(connection.latestRun.startedAt)}</p></div><p className="text-right text-neutral-300">{connection.latestRun.processedCount} elemente procesate<br />{labels[connection.latestRun.status === "failed" ? "error" : connection.latestRun.status === "running" ? "syncing" : "connected"]}</p></div></div> : null}
          <details className="text-xs text-neutral-400"><summary className="focus-ring cursor-pointer rounded font-semibold text-neutral-300">Detalii tehnice</summary><p className="mt-2 leading-5">Acces acordat: identitate Google, Gmail pentru citire și Calendar doar-citire. Permisiunea Gmail send este separată și este activă numai când apare explicit mai sus. Tokenurile nu sunt expuse în browser.</p></details>
          <div className="flex items-center justify-between gap-4 border-t border-white/[0.08] pt-4"><p className="max-w-xl text-xs leading-5 text-neutral-500">Deconectarea revocă accesul când Google răspunde, invalidează credentialul local și șterge contextul Gmail și Calendar sincronizat pentru acest cont.</p><button type="button" disabled={pending} onClick={() => mutate("/api/integrations/google/disconnect", "Contul Google a fost deconectat, iar contextul sincronizat a fost eliminat.")} className="focus-ring min-h-9 shrink-0 rounded-[8px] border border-red-900/70 px-3 text-xs font-semibold text-red-300 hover:bg-red-950/30 disabled:opacity-60">Deconectează</button></div>
        </div>
      ) : null}
    </section>
  );
}
