import {
  ArrowPathRoundedSquareIcon,
  CircleStackIcon,
  LinkIcon,
  ShieldCheckIcon,
  SignalIcon
} from "@heroicons/react/24/outline";
import { GoogleWorkspaceCard } from "@/components/apps/GoogleWorkspaceCard";
import { IntegrationCatalog } from "@/components/apps/IntegrationCatalog";
import { DataSummaryStrip } from "@/components/ui/DataSummaryStrip";
import { SectionHeader } from "@/components/ui/SectionHeader";
import { StatusPill } from "@/components/ui/StatusPill";
import { getGoogleWorkspacePublicState } from "@/lib/google-workspace/repository";
import { requirePermission } from "@/lib/authz/require-permission";

export const dynamic = "force-dynamic";

export default async function AppsPage({ searchParams }: { searchParams?: { google?: string } }) {
  await requirePermission("workspace.read");
  const state = await getGoogleWorkspacePublicState();
  const connection = state.connection;
  const connectedSources = connection
    ? Number(connection.capabilities.gmail) + Number(connection.capabilities.calendar)
    : 0;
  const externalContextActive = Boolean(connection?.lastSuccessfulSyncAt);
  const syncHealthy = connection?.gmailStatus === "connected" && connection?.calendarStatus === "connected";

  return (
    <main className="mx-auto w-full max-w-[1180px] px-4 pb-24 pt-6 sm:px-6 lg:px-8 lg:pb-14 lg:pt-8">
      <SectionHeader
        eyebrow="Aplicații și surse"
        title="Conectează contextul în care se întâmplă munca."
        description="ReveNew aduce conversațiile, întâlnirile, CRM-ul, documentele și semnalele într-un context comercial comun. Fiecare sursă rămâne autorizată explicit, iar acțiunile externe sunt separate de analiză."
        actions={
          externalContextActive
            ? <StatusPill tone={syncHealthy ? "success" : "warning"}>{syncHealthy ? "Context extern activ" : "Context necesită atenție"}</StatusPill>
            : <StatusPill tone="neutral">Fără context extern activ</StatusPill>
        }
      />

      <div className="mt-6">
        <DataSummaryStrip
          label="Starea integrărilor"
          items={[
            {
              label: "Surse active",
              value: connectedSources,
              note: connectedSources ? "Gmail și Calendar sunt evaluate separat." : "Conectează prima sursă autorizată.",
              tone: connectedSources ? "success" : "neutral"
            },
            {
              label: "Context extern",
              value: externalContextActive ? "Activ" : "Inactiv",
              note: externalContextActive ? "Ultima sincronizare reușită este disponibilă." : "Nu există încă date externe sincronizate.",
              tone: externalContextActive ? "success" : "neutral"
            },
            {
              label: "Control",
              value: "Uman",
              note: "Trimiterea și modificările cu efect extern cer aprobare explicită.",
              tone: "brand"
            },
            {
              label: "Roadmap",
              value: "8",
              note: "Conectori prioritizați pentru comunicare, CRM și contracte.",
              tone: "gold"
            }
          ]}
        />
      </div>

      <section className="mt-9" aria-labelledby="connected-apps-title">
        <div className="flex flex-col gap-3 border-b border-[rgb(var(--border))] pb-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p className="micro-label">Conectat acum</p>
            <h2 id="connected-apps-title" className="mt-1 text-lg font-semibold tracking-[-0.015em] text-[rgb(var(--foreground))]">Google Workspace</h2>
            <p className="mt-1 max-w-2xl text-sm leading-6 text-[rgb(var(--text-muted))]">Gmail și Calendar alimentează contextul privat al utilizatorului și pot fi folosite de Ask ReveNew, Inbox și motorul de intervenții.</p>
          </div>
          <div className="flex items-center gap-2 text-xs text-[rgb(var(--text-muted))]">
            <ArrowPathRoundedSquareIcon className="h-4 w-4" aria-hidden="true" />
            Sincronizare controlată
          </div>
        </div>
        <div className="pt-5">
          <GoogleWorkspaceCard state={state} notice={searchParams?.google ?? null} />
        </div>
      </section>

      <section className="mt-10 grid gap-6 border-y border-[rgb(var(--border))] py-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,.65fr)]">
        <div>
          <p className="micro-label">Din sursă în decizie</p>
          <h2 className="mt-1 text-lg font-semibold tracking-[-0.015em] text-[rgb(var(--foreground))]">Integrarea nu este doar import de date.</h2>
          <div className="mt-5 grid gap-0 border-y border-[rgb(var(--border))]">
            {[
              { icon: LinkIcon, index: "01", title: "Conectează", copy: "Utilizatorul autorizează sursa și capabilitățile necesare." },
              { icon: CircleStackIcon, index: "02", title: "Normalizează contextul", copy: "ReveNew leagă sursa de companii, contacte, oportunități și starea execuției." },
              { icon: SignalIcon, index: "03", title: "Transformă în intervenție", copy: "Ask, Control Center și workflow-urile folosesc contextul pentru priorități și lucru pregătit." }
            ].map((step) => (
              <div key={step.index} className="grid gap-3 border-b border-[rgb(var(--border))] py-4 last:border-b-0 sm:grid-cols-[2.5rem_2rem_minmax(0,1fr)] sm:items-start">
                <span className="grid h-8 w-8 place-items-center rounded-control border border-[rgb(var(--border))] bg-[rgb(var(--surface-subtle))] text-[rgb(var(--text-muted))]"><step.icon className="h-4 w-4" aria-hidden="true" /></span>
                <span className="pt-1 text-[0.6875rem] font-semibold tabular-nums text-[rgb(var(--text-faint))]">{step.index}</span>
                <div>
                  <h3 className="text-sm font-semibold text-[rgb(var(--foreground))]">{step.title}</h3>
                  <p className="mt-1 text-xs leading-5 text-[rgb(var(--text-muted))]">{step.copy}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <aside className="decision-rail p-5">
          <div className="flex items-center gap-2 text-[rgb(var(--primary))]">
            <ShieldCheckIcon className="h-4 w-4" aria-hidden="true" />
            <p className="text-xs font-semibold uppercase tracking-[0.12em]">Guvernanță implicită</p>
          </div>
          <h2 className="mt-2 text-base font-semibold text-[rgb(var(--foreground))]">Conectat nu înseamnă autonom.</h2>
          <ul className="mt-4 grid gap-2.5 text-xs leading-5 text-[rgb(var(--text-muted))]">
            <li>Conexiunile aparțin utilizatorului sau workspace-ului care le autorizează.</li>
            <li>Tokenurile și secretele rămân server-side.</li>
            <li>Sursele externe sunt tratate ca date, nu ca instrucțiuni.</li>
            <li>Acțiunile cu efect extern cer o confirmare separată.</li>
            <li>Fiecare integrare trebuie să poată fi revocată și auditată.</li>
          </ul>
        </aside>
      </section>

      <div className="mt-10">
        <IntegrationCatalog />
      </div>
    </main>
  );
}
