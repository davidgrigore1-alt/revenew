# PUBLIC SAFE. These values identify the Supabase project; they are not privileged
# credentials. Both are required for Supabase-backed production operation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PRODUCTION REQUIRED. Public canonical HTTPS origin used for metadata and links.
REVENEW_PUBLIC_SITE_URL=

# SERVER ONLY. Store only in an ignored local file or approved secret store.
# Never expose these values through NEXT_PUBLIC_* or client code.
SUPABASE_SERVICE_ROLE_KEY=""
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# OPTIONAL INTEGRATION. External providers remain disabled or unavailable unless
# their complete configuration and an explicit runtime mode are supplied.
OPENAI_MODEL=
REVENEW_AI_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_PICKER_APP_ID=
GOOGLE_PICKER_BROWSER_KEY=
EMAIL_SENDING_MODE=
EMAIL_FROM_ADDRESS=
INVITATION_DELIVERY_MODE=

# SERVER-ONLY RUNTIME CONTROLS. Configure deliberately; blank values retain the
# application's documented fail-safe behavior and do not enable live integrations.
REVENEW_ACCESS_MODE=
REVENEW_USAGE_MODE=

# LOCAL DEVELOPMENT ONLY. Do not configure these local/demo controls in production.
REVENEW_DEMO_PASSWORD=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_KEEP_ALIVE=
OLLAMA_TIMEOUT_MS=
OLLAMA_MAX_INPUT_CHARS=
OLLAMA_NUM_CTX=
OLLAMA_NUM_PREDICT=
